# API local. Copie para .env e preencha com valores locais; nunca use estes
# placeholders em staging/produção.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ged?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GED_INTERNAL_SECRET=replace-with-a-different-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Número exato de proxies confiáveis à frente da API (0 em acesso local direto).
TRUST_PROXY_HOPS=0
SEED_DEFAULT_PASSWORD=replace-with-a-local-seed-password-of-at-least-12-characters

# Credenciais apenas para desenvolvimento local. Em produção, prefira IAM role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=replace-me
AWS_SQS_OCR_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/replace-me
