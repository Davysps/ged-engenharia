// Prisma schema for GED Engenharia
// https://www.prisma.io/docs/concepts/components/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum GlobalRole {
  SYSADMIN // Dono do SaaS (nós)
  USER // Utilizador comum logado
}

enum ContractRole {
  GESTOR // Pode criar/editar documentos e convidar pessoas
  ENGENHEIRO // Pode submeter novas revisões (R0, R1)
  APROVADOR // Pode aprovar/rejeitar revisões
  LEITOR // Só pode visualizar/baixar
}

enum RevisionStatus {
  EM_ELABORACAO
  EM_REVISAO
  APROVADO
  REJEITADO
  OBSOLETO
}

// ÉPICO 10: Motor de Aprovação Estrito — status exatos exigidos pelo fluxo
enum ApprovalStatus {
  PENDENTE // Aguardando análise
  APROVADO // Aprovado sem comentários
  APROVADO_COM_COMENTARIOS // Aprovado com comentários registrados
  REPROVADO // Reprovado com justificativa
}

// PATCH 10.2: Estágio do Carimbo dentro da Máquina de Estados de Engenharia
enum ApprovalStage {
  VERIFICACAO // Carimbo 1 — Time Interno (Sênior/Pleno)
  APROVACAO // Carimbo 2 — Coordenação
  CLIENTE // Carimbo 3 — Análise do Cliente pós-emissão (GRD)
}

enum Discipline {
  ELETRICA
  HIDRAULICA
  ESTRUTURAL
  MECANICA
  CIVIL
  ARQUITETURA
  OUTRO
}

// ÉPICO 4 - Controlo de estado assíncrono para o worker Python
enum TransmittalStatus {
  EM_PROCESSAMENTO // Node registou e enviou para o Python
  CONCLUIDO // Python terminou de gerar ZIP e PDF no S3
  ERRO // Falha no processamento pelo worker
}

// NOVO: ÉPICO 5 - Controlo de estado do OCR
enum DocumentOcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// --- MODELS ---

model Client {
  id        Int        @id @default(autoincrement())
  nome      String
  cnpj      String?    @unique
  contracts Contract[]
  projects  Project[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ÉPICO 9: Hierarquia Estrutural — Cliente > Projeto > Contrato
model Project {
  id        Int        @id @default(autoincrement())
  client    Client     @relation(fields: [clientId], references: [id])
  clientId  Int
  nome      String
  contracts Contract[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([clientId])
}

model Contract {
  id          Int                  @id @default(autoincrement())
  client      Client               @relation(fields: [clientId], references: [id])
  clientId    Int
  // ÉPICO 9: Vínculo opcional ao Projeto (retrocompatibilidade — pode ser null)
  project     Project?             @relation(fields: [projectId], references: [id])
  projectId   Int?
  codigo      String               @unique
  nome        String
  descricao   String?
  memberships ContractMembership[]
  documents   Document[]
  disciplines ContractDiscipline[]

  // Relação Épico 4
  transmittals Transmittal[]

  // Relação Épico 7: Pacotes de Trabalho do Planejamento
  workPackages WorkPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ÉPICO 6: Gestão de Disciplinas (Multi-Tenant)
model ContractDiscipline {
  id         Int      @id @default(autoincrement())
  contract   Contract @relation(fields: [contractId], references: [id])
  contractId Int
  nome       String
  codigo     String
  descricao  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ÉPICO 7.5: Documentos vinculados a esta disciplina do contrato
  documents Document[]

  @@unique([contractId, codigo])
  @@index([contractId])
}

model User {
  id         Int        @id @default(autoincrement())
  nome       String
  email      String     @unique
  senhaHash  String     @map("senha_hash")
  globalRole GlobalRole @default(USER)
  // ÉPICO 10: Usuário externo (Cliente) ou membro interno (Time) do GED Engenharia
  isClient   Boolean    @default(false)

  contracts        ContractMembership[]
  documentsCreated Document[]           @relation("UserCreatedDocuments")

  requestedApprovals ApprovalWorkflow[] @relation("UserRequestedApprovals")
  reviewedApprovals  ApprovalWorkflow[] @relation("UserReviewedApprovals")

  // Relação Épico 4
  createdTransmittals Transmittal[] @relation("UserCreatedTransmittals")

  // Relação Épico 9: Apontamento de Horas (Timesheet)
  timeLogs TimeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContractMembership {
  id         Int          @id @default(autoincrement())
  user       User         @relation(fields: [userId], references: [id])
  userId     Int
  contract   Contract     @relation(fields: [contractId], references: [id])
  contractId Int
  role       ContractRole @default(LEITOR)
  createdAt  DateTime     @default(now())

  @@unique([userId, contractId])
}

model Document {
  id              Int      @id @default(autoincrement())
  contract        Contract @relation(fields: [contractId], references: [id])
  contractId      Int
  codigoDocumento String   @map("codigo_documento")
  titulo          String
  metadata        Json?

  // NOVO: ÉPICO 5 - Extração Inteligente (RPA/OCR)
  ocrStatus         DocumentOcrStatus @default(PENDING)
  projectNumber     String?
  extractedRevision String? // Nomeado para não conflitar com a relação "revisions"
  extractedMetadata Json? // Payload bruto do AWS Textract para auditoria

  // ÉPICO 7.5: Vínculo opcional com Planejamento (Pacotes de Trabalho) e Disciplinas do Contrato
  workPackageId        Int?
  workPackage          WorkPackage?        @relation(fields: [workPackageId], references: [id])
  contractDisciplineId Int?
  contractDiscipline   ContractDiscipline? @relation(fields: [contractDisciplineId], references: [id])

  createdBy   User       @relation("UserCreatedDocuments", fields: [createdById], references: [id])
  createdById Int
  createdAt   DateTime   @default(now())
  revisions   Revision[]

  // Relação Épico 9: Apontamento de Horas e Relacionamentos entre Documentos
  timeLogs    TimeLog[]
  sourceLinks DocumentLink[] @relation("SourceDocumentLinks")
  targetLinks DocumentLink[] @relation("TargetDocumentLinks")

  @@unique([contractId, codigoDocumento])
}

model Revision {
  id           Int            @id @default(autoincrement())
  document     Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId   Int
  versionLabel String // Ex: R0, R1, A, B
  filePath     String
  fileHash     String
  status       RevisionStatus @default(EM_ELABORACAO)
  comments     Json? // Para futuro Markup/Redlining
  createdAt    DateTime       @default(now())

  // PATCH 10.2: Histórico de aprovações — UM revision pode ter VÁRIOS carimbos
  // (Verificação → Aprovação → Análise do Cliente). Cada carimbo é um registro
  // novo, preservando o histórico e nunca sobrescrevendo o antigo.
  approvalWorkflows ApprovalWorkflow[]

  // Relação Épico 4
  transmittalItems TransmittalItem[]
}

model ApprovalWorkflow {
  id          Int            @id @default(autoincrement())
  revision    Revision       @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  // PATCH 10.2: Removida a restrição @unique — cada carimbo é um registro novo
  revisionId  Int
  requester   User           @relation("UserRequestedApprovals", fields: [requesterId], references: [id])
  requesterId Int
  reviewer    User?          @relation("UserReviewedApprovals", fields: [reviewerId], references: [id])
  reviewerId  Int?
  status      ApprovalStatus @default(PENDENTE)
  comments    String?        @db.Text
  // ÉPICO 10: Diferencia se o autor da ação é interno (Time) ou externo (Cliente)
  isClient    Boolean        @default(false)
  // PATCH 10.2: Estágio do carimbo na Máquina de Estados de Engenharia
  stage       ApprovalStage  @default(VERIFICACAO)
  // PATCH 10.2: Link do PDF comentado anexado na análise (aprovado c/ comentários ou reprovado)
  commentedFileUrl String?
  requestedAt DateTime       @default(now())
  reviewedAt  DateTime?

  @@index([status])
  @@index([requesterId])
  @@index([revisionId])
}

model Transmittal {
  id         Int      @id @default(autoincrement())
  contract   Contract @relation(fields: [contractId], references: [id])
  contractId Int
  codigo     String

  destinatario String? @db.VarChar(100) // Para quem vai a GRD
  proposito    String  @default("PARA_CONHECIMENTO") // Motivo da Emissão

  assunto  String
  mensagem String? @db.Text

  status TransmittalStatus @default(EM_PROCESSAMENTO)

  zipUrl     String?
  pdfCapaUrl String?

  createdBy   User @relation("UserCreatedTransmittals", fields: [createdById], references: [id])
  createdById Int

  items TransmittalItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, codigo])
  @@index([status])
}

model TransmittalItem {
  id            Int         @id @default(autoincrement())
  transmittal   Transmittal @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  transmittalId Int

  revision   Revision @relation(fields: [revisionId], references: [id])
  revisionId Int

  @@unique([transmittalId, revisionId])
}

// ÉPICO 7: Módulo de Planejamento e Coordenação — Pacotes de Trabalho
model WorkPackage {
  id         Int      @id @default(autoincrement())
  contract   Contract @relation(fields: [contractId], references: [id])
  contractId Int
  nome       String
  descricao  String?
  dataInicio DateTime
  dataFim    DateTime
  status     String   @default("PENDENTE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ÉPICO 7.5: Documentos vinculados a este pacote de trabalho
  documents Document[]

  // Relação Épico 9: Apontamento de Horas no Pacote de Trabalho
  timeLogs TimeLog[]

  @@index([contractId])
  @@index([status])
}

// ÉPICO 9: Apontamento de Horas (Timesheet)
// O userId é sempre extraído do token JWT autenticado (nunca do body).
model TimeLog {
  id            Int          @id @default(autoincrement())
  horas         Float
  data          DateTime
  descricao     String
  user          User         @relation(fields: [userId], references: [id])
  userId        Int
  document      Document?    @relation(fields: [documentId], references: [id])
  documentId    Int?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id])
  workPackageId Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([documentId])
  @@index([workPackageId])
}

// ÉPICO 9: Relacionamentos / Anexos entre Documentos
model DocumentLink {
  id          Int      @id @default(autoincrement())
  sourceDoc   Document @relation("SourceDocumentLinks", fields: [sourceDocId], references: [id])
  sourceDocId Int
  targetDoc   Document @relation("TargetDocumentLinks", fields: [targetDocId], references: [id])
  targetDocId Int
  tipo        String   @default("REFERENCIA") // Ex: 'REFERENCIA', 'ANEXO'
  createdAt   DateTime @default(now())

  @@unique([sourceDocId, targetDocId])
  @@index([sourceDocId])
  @@index([targetDocId])
}
